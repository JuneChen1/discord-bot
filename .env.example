# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=

# Channel ID to send reminders to (optional, defaults to the command channel)
REMINDER_CHANNEL_ID=

# Directory for persistent data storage (optional, defaults to project root)
# Required on Railway: set to the volume mount path (e.g. /data) to persist reminders.json across deploys
DATA_DIR=

# Signing secret for the read-only reminders web page link generated by /reminders (optional but recommended)
# If unset, a random secret is generated at startup, invalidating all links on every restart
WEB_TOKEN_SECRET=

# Public base URL for the reminders web page (optional)
# Auto-detected from Railway's RAILWAY_PUBLIC_DOMAIN when deployed there; set manually otherwise (e.g. https://example.com)
PUBLIC_BASE_URL=